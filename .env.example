# Copy to .env and fill in to run Heimdall live. With none of these set,
# Heimdall runs in simulator mode and needs nothing.

# At least one model provider. Several is better: rehearsals can then
# compare a replacement from another provider.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=

# Tavily: registered on the gateway as a relay. Heimdall reaches Tavily only
# through Bifrost. Get a key at https://app.tavily.com
TAVILY_API_KEY=

# Password for the Heimdall dashboard. Required in live mode; if left empty
# one is generated and printed in the container log at startup.
HEIMDALL_ADMIN_TOKEN=

# Optional. The model Heimdall uses to read evidence and judge replays, as
# provider/model. Left empty, Heimdall picks a small current model from the
# gateway's own model list.
HEIMDALL_ANALYST_MODEL=

# Optional. Slack-compatible incoming webhook for alerts.
HEIMDALL_ALERT_WEBHOOK_URL=
